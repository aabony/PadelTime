{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "padeltime",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "padeltime.andrewabony.com", "custom_domain": true }],
  "workers_dev": true,
  "vars": {
    // Sending domain verified in Resend — codes deliver to any address.
    "MAIL_FROM": "PadelTime <login@padeltime.andrewabony.com>",
    // Who can run tournaments. Everyone else who signs in is a player.
    // Comma-separated emails; "*@example.com" allows a whole domain.
    "ADMIN_EMAILS": "andrew@adbloom.com"
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/join/*", "/board/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "padeltime-db",
      "database_id": "f40da4f8-9f69-4756-b6dd-7ac6699132ae",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
